# Redis 缓存连接 (开发环境通常使用 redis://localhost:6379/0)
REDIS_URL="redis://:password@host:port/db"

# PostgreSQL 数据库连接 (开发环境通常使用 sqlite 备选)
DATABASE_URL="postgres://user:password@host:port/dbname"

# Cloudflare Worker 中继代理配置 (用于爬取敏感海外数据)
CF_WORKER_PROXY_URL="https://your-worker-subdomain.workers.dev"
CF_WORKER_SECRET_KEY="your-optional-proxy-token"

# 阿里云服务器自动化部署配置
ALIYUN_HOST="your-aliyun-ip"
ALIYUN_USER="root"
ALIYUN_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
your_ssh_private_key_lines_here
-----END OPENSSH PRIVATE KEY-----"
