# Redis 缓存连接 (开发环境通常通过本地隧道连接: redis://:password@127.0.0.1:6379/0)
REDIS_URL="redis://:password@127.0.0.1:6379/0"

# PostgreSQL 数据库连接 (开发环境通常通过本地隧道连接: postgres://user:password@127.0.0.1:5432/dbname)
DATABASE_URL="postgres://user:password@127.0.0.1:5432/dbname"

# Cloudflare Worker 中继代理配置 (用于爬取海外受限金融数据)
CF_WORKER_PROXY_URL="https://your-worker-subdomain.workers.dev"
CF_WORKER_SECRET_KEY="your-proxy-token"

# 管理员鉴权 Token (可选)
ADMIN_TOKEN="your-admin-token"

# 本地开发 SSH 数据库安全隧道目标别名 (对应 ~/.ssh/config 中的 Host，如 a1)
# 配置后，本地运行 python server.py 或 ./tunnel.sh 将自动打通云端 5432 与 6379 的映射
DEPLOY_SSH_ALIAS="a1"
